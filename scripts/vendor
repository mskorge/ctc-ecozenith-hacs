#!/usr/bin/env bash
# Copy the ctc_ecozenith library source from a local checkout of ctc-ecozenith
# into this repo's vendor tree and stamp its version. Run this after every
# ctc-ecozenith release you want to ship.
#
#   scripts/vendor ../ctc-ecozenith

set -euo pipefail
cd "$(dirname "$0")/.."

SRC="${1:?usage: scripts/vendor /path/to/ctc-ecozenith}"
DEST="custom_components/ctc_ecozenith/vendor"

if [ ! -d "${SRC}/src/ctc_ecozenith" ]; then
    echo "error: ${SRC}/src/ctc_ecozenith not found" >&2
    exit 1
fi

rm -rf "${DEST}/ctc_ecozenith"
mkdir -p "${DEST}"
cp -r "${SRC}/src/ctc_ecozenith" "${DEST}/ctc_ecozenith"
cp "${SRC}/LICENSE" "${DEST}/LICENSE"
find "${DEST}/ctc_ecozenith" -name '__pycache__' -type d -prune -exec rm -rf {} +
find "${DEST}/ctc_ecozenith" -name '*.pyc' -delete

if VERSION="$(git -C "${SRC}" describe --tags --always --dirty 2>/dev/null)"; then
    :
else
    VERSION="unknown"
fi

cat > "${DEST}/ctc_ecozenith/_vendor_version.py" <<EOF
"""Generated by scripts/vendor - do not edit."""

__version__ = "${VERSION}"
EOF

echo "Vendored ctc_ecozenith @ ${VERSION} -> ${DEST}/ctc_ecozenith"
